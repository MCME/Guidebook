root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true

[*.java]
# Formatting is done by Palantir (Spotless + IntelliJ plugin); these only stop IntelliJ adding wildcard imports
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

[*.md]
# IntelliJ's format on save would otherwise re-wrap paragraphs at the right margin, splitting links and code spans
ij_markdown_wrap_text_if_long = false
ij_markdown_keep_line_breaks_inside_text_blocks = true
