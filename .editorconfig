root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true

[*.java]
# Formatting is done by Palantir (Spotless + IntelliJ plugin); these only stop IntelliJ adding wildcard imports
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
